# Server environment — keep private.
PORT=4000
# Neon Postgres connection string (includes ?sslmode=require)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Gemini API key (server-side, never exposed to the browser)
GEMINI_API_KEY=your_gemini_key_here
# Secret for signing student auth tokens — change to a long random string
JWT_SECRET=change_me_to_a_long_random_secret
# Allowed frontend origin
CLIENT_ORIGIN=http://localhost:5173
